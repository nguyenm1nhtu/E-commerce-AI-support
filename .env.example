# Copy to .env.dev or .env.prod and fill in credentials.
# Never put real credentials in this tracked template.
# Single-quote passwords containing $ or #.
POSTGRES_DB=ai_commerce_support
POSTGRES_USER=support
POSTGRES_PASSWORD=

# Host ports used only by compose.dev.yaml (bound to localhost).
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_NAMESPACE=ai-commerce-support
REDIS_CACHE_TTL=10m

# Required only by compose.prod.yaml; dev Redis does not require authentication.
REDIS_PASSWORD=
