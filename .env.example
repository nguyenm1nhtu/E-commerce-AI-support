# Copy to .env.dev or .env.prod and fill in credentials.
# Never put real credentials in this tracked template.
# Single-quote passwords containing $ or #.
POSTGRES_DB=ai_commerce_support
POSTGRES_USER=support
POSTGRES_PASSWORD=

# Host ports used only by compose.dev.yaml (bound to localhost).
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_NAMESPACE=ai-commerce-support
REDIS_CACHE_TTL=10m

# Required by the backend. Generate a separate random Base64 secret (at least 32 bytes) per environment.
JWT_SECRET=
JWT_ISSUER=ai-commerce-support
JWT_AUDIENCE=ai-commerce-support-api
JWT_ACCESS_TOKEN_TTL=15m

# Refresh session absolute lifetime and cookie settings. Set Secure=false only for local dev HTTP.
AUTH_REFRESH_COOKIE_MAX_AGE=7d
AUTH_REFRESH_COOKIE_SAME_SITE=Lax
AUTH_REFRESH_COOKIE_SECURE=true

# Required only by compose.prod.yaml; dev Redis does not require authentication.
REDIS_PASSWORD=
